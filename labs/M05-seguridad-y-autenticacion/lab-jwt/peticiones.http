### Punto de partida

curl -X PUT -H 'Content-Type: application/json' \
  -d '{"plato":"pescado"}' \
  http://127.0.0.1:3001/recetas/r1

### 1 — Firmar el rol

curl -X POST -H 'Content-Type: application/json' \
  -d '{"sub":"noa","clave":"no"}' \
  http://127.0.0.1:3001/sesion

### 1 — Firmar el rol

curl -X POST -H 'Content-Type: application/json' \
  -d '{"sub":"noa","clave":"lab"}' \
  http://127.0.0.1:3001/sesion

### 1 — Firmar el rol

curl -X PUT -H 'Content-Type: application/json' \
  -d '{"plato":"pescado"}' \
  http://127.0.0.1:3001/recetas/r1

### 2 — Cerrar la lectura

curl http://127.0.0.1:3001/recetas/r1

### 2 — Cerrar la lectura

# @name noaPaso2
curl -X POST -H 'Content-Type: application/json' \
  -d '{"sub":"noa","clave":"lab"}' \
  http://127.0.0.1:3001/sesion

### 2 — Cerrar la lectura

curl -H 'Authorization: Bearer {{noaPaso2.response.body.$.token}}' \
  http://127.0.0.1:3001/recetas/r1

